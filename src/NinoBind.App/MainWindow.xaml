<Window x:Class="NinoBind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NinoBind"
        Icon="Assets/ninobind.ico"
        Style="{StaticResource AppWindow}"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="WindowKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SidebarLineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8,20,8,16">
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" ClipToBounds="True" CornerRadius="17">
                            <Image Source="Assets/ninobind-mark.png" Width="96" Height="96"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NinoBind" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Teclado e mouse" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" CornerRadius="10" Margin="8,0" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Margin="0,0,0,12"
                                   Text="O motor precisa estar ativo para os bindings funcionarem."
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="EngineButton" Style="{StaticResource PriButton}"
                                HorizontalAlignment="Stretch" Click="EngineClicked"
                                ToolTip="Scroll Lock"
                                AutomationProperties.Name="Ativar ou desativar o motor de remapeamento"
                                AutomationProperties.AcceleratorKey="Scroll Lock">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="EngineLabel" Text="Ativar motor" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <RadioButton x:Name="OverviewNav" Style="{StaticResource NavButton}" GroupName="Sections" IsChecked="True" Checked="SectionChanged" Tag="overview" AutomationProperties.Name="Visão geral" AutomationProperties.AcceleratorKey="Ctrl+1" ToolTip="Ctrl + 1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                            <TextBlock Text="Visão geral" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DevicesNav" Style="{StaticResource NavButton}" GroupName="Sections" Checked="SectionChanged" Tag="devices" AutomationProperties.Name="Dispositivos" AutomationProperties.AcceleratorKey="Ctrl+2" ToolTip="Ctrl + 2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE92E;" />
                            <TextBlock Text="Dispositivos" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BindingsNav" Style="{StaticResource NavButton}" GroupName="Sections" Checked="SectionChanged" Tag="bindings" AutomationProperties.Name="Bindings" AutomationProperties.AcceleratorKey="Ctrl+3" ToolTip="Ctrl + 3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" />
                            <TextBlock Text="Bindings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MacrosNav" Style="{StaticResource NavButton}" GroupName="Sections" Checked="SectionChanged" Tag="macros" AutomationProperties.Name="Macros" AutomationProperties.AcceleratorKey="Ctrl+4" ToolTip="Ctrl + 4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE768;" />
                            <TextBlock Text="Macros" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ProfilesNav" Style="{StaticResource NavButton}" GroupName="Sections" Checked="SectionChanged" Tag="profiles" AutomationProperties.Name="Perfis" AutomationProperties.AcceleratorKey="Ctrl+5" ToolTip="Ctrl + 5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;" />
                            <TextBlock Text="Perfis" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavButton}" GroupName="Sections" Checked="SectionChanged" Tag="settings" AutomationProperties.Name="Configurações" AutomationProperties.AcceleratorKey="Ctrl+6" ToolTip="Ctrl + 6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                            <TextBlock Text="Configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource FundoBrush}" BorderBrush="{StaticResource SidebarLineBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <TextBlock x:Name="BreadcrumbText" Style="{StaticResource BreadcrumbText}" Text="PAINEL" />
                    <Border x:Name="MotorBadge" Style="{StaticResource BadgeDanger}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MotorDot" Width="8" Height="8" Fill="{StaticResource DangerDotBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MotorBadgeText" Text="Motor parado" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ContentControl x:Name="SectionHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
