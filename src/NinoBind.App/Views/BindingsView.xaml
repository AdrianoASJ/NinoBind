<UserControl x:Class="NinoBind.Views.BindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Bindings" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,12" TextWrapping="Wrap"
                       Text="O motor aplica apenas bindings do perfil ativo marcados como Qualquer dispositivo. Um binding preso a um aparelho fica salvo, mas o hook do Windows não consegue limitá-lo a esse hardware." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="AddButton" Content="Adicionar" Style="{StaticResource PrimaryButton}" Click="AddClicked" AutomationProperties.Name="Adicionar binding" />
                <Button Content="Editar" Style="{StaticResource ActionButton}" Click="EditClicked" AutomationProperties.Name="Editar binding" />
                <Button Content="Duplicar" Style="{StaticResource ActionButton}" Click="DuplicateClicked" AutomationProperties.Name="Duplicar binding" />
                <Button Content="Excluir" Style="{StaticResource ActionButton}" Click="DeleteClicked" AutomationProperties.Name="Excluir binding" />
                <Button x:Name="ToggleButton" Content="Ativar" Style="{StaticResource ActionButton}" Click="ToggleClicked" AutomationProperties.Name="Ativar ou desativar binding" />
                <Button Content="Testar" Style="{StaticResource ActionButton}" Click="TestClicked" AutomationProperties.Name="Testar ação" />            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Width="220" Tag="Pesquisar…" Margin="0,0,8,0" TextChanged="FilterChanged" AutomationProperties.Name="Pesquisar bindings" />
                <ComboBox x:Name="DeviceFilter" Width="220" Margin="0,0,8,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filtrar por dispositivo" />
                <ComboBox x:Name="ProfileFilter" Width="180" SelectionChanged="FilterChanged" AutomationProperties.Name="Filtrar por perfil" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        <ListView x:Name="BindingList" AutomationProperties.Name="Lista de bindings">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Dispositivo" DisplayMemberBinding="{Binding Device}" Width="190" />
                    <GridViewColumn Header="Entrada" DisplayMemberBinding="{Binding Input}" Width="140" />
                    <GridViewColumn Header="Ação" DisplayMemberBinding="{Binding Action}" Width="180" />
                    <GridViewColumn Header="Perfil" DisplayMemberBinding="{Binding Profile}" Width="120" />
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="160" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
