<UserControl x:Class="NinoBind.Views.BindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PageShell}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TitleText}">
                            <Run Text="Os seus " />
                            <Run Text="bindings" Foreground="{StaticResource GoldBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Text="O que cada tecla ou botão faz quando o motor está ativo." />
                        <Button Style="{StaticResource HelpButton}" Margin="8,0,0,0"
                                ToolTip="O motor aplica apenas bindings do perfil ativo marcados como Qualquer dispositivo. Um binding preso a um aparelho fica salvo, mas o hook do Windows não consegue limitá-lo a esse hardware."
                                AutomationProperties.Name="Ajuda sobre bindings" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="AddButton" Content="+  Adicionar binding" Style="{StaticResource PriButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddClicked"
                        AutomationProperties.Name="Adicionar binding" />
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,0,10,0" Tag="Pesquisar por entrada, ação ou macro"
                             TextChanged="FilterChanged" AutomationProperties.Name="Pesquisar bindings" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ComboBox x:Name="DeviceFilter" Grid.Column="2" SelectionChanged="FilterChanged"
                          AutomationProperties.Name="Filtrar por dispositivo" />
                <ComboBox x:Name="ProfileFilter" Grid.Column="4" SelectionChanged="FilterChanged"
                          AutomationProperties.Name="Filtrar por perfil" />
            </Grid>

            <StackPanel>
            <Border x:Name="EmptyPanel" Margin="0,0,0,8" Style="{StaticResource EmptyState}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" />
                    </Border>
                    <TextBlock Text="Nenhum binding ainda" Style="{StaticResource CardTitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Crie o primeiro para dizer o que cada tecla ou botão faz."
                               Style="{StaticResource MetaText}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                    <Button Content="Adicionar binding" Style="{StaticResource PriButton}" HorizontalAlignment="Center"
                            Click="AddClicked" AutomationProperties.Name="Adicionar o primeiro binding" />
                </StackPanel>
            </Border>

            <ListView x:Name="BindingList" AutomationProperties.Name="Lista de bindings"
                      MouseDoubleClick="RowDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="200">
                            <GridViewColumn.Header>
                                <TextBlock Text="DISPOSITIVO" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DeviceGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource IconBlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Device}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <TextBlock Text="ENTRADA" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GoldChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding InputGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource GoldBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Input}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="190">
                            <GridViewColumn.Header>
                                <TextBlock Text="AÇÃO" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Action}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <TextBlock Text="PERFIL" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Profile}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="120">
                            <GridViewColumn.Header>
                                <TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Tag="{Binding Id}" Click="StatusToggled"
                                                  AutomationProperties.Name="Ativar ou desativar binding" />
                                        <TextBlock Text="Ativo" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding EnabledVisibility}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="148">
                            <GridViewColumn.Header>
                                <TextBlock Text="AÇÕES" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Testar"
                                                Tag="{Binding Id}" Click="TestRowClicked" AutomationProperties.Name="Testar binding" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Editar"
                                                Tag="{Binding Id}" Click="EditRowClicked" AutomationProperties.Name="Editar binding" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicar"
                                                Tag="{Binding Id}" Click="DuplicateRowClicked" AutomationProperties.Name="Duplicar binding" />
                                        <Button Style="{StaticResource IconButton}" ToolTip="Excluir"
                                                Tag="{Binding Id}" Click="DeleteRowClicked" AutomationProperties.Name="Excluir binding">
                                            <TextBlock Text="&#xE74D;" Foreground="{StaticResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Margin="0,10,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
