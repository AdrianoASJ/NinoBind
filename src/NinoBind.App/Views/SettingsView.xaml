<UserControl x:Class="NinoBind.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource PageShellNarrow}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}">
                    <Run Text="As " />
                    <Run Text="configurações" Foreground="{StaticResource GoldBrush}" />
                </TextBlock>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,24"
                           Text="As mudanças são salvas na hora. O NinoBind não pede privilégios de administrador." />

                <TextBlock Text="INICIALIZAÇÃO" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="16,14">
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="Iniciar com o Windows" Style="{StaticResource CardTitleText}" />
                                <TextBlock x:Name="StartupText" Style="{StaticResource MetaText}" Margin="0,4,0,0"
                                           Text="Abre minimizado na bandeja do Windows." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="StartupStateText" Text="Desligado" Style="{StaticResource MetaText}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="StartupBox" Style="{StaticResource ToggleSwitch}" Click="StartupClicked"
                                          AutomationProperties.Name="Iniciar com o Windows" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" />
                        <Grid Margin="16,14">
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="Fechar mantém na bandeja" Style="{StaticResource CardTitleText}" />
                                <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0"
                                           Text="O X esconde a janela. Use Sair no ícone da bandeja para encerrar." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TrayStateText" Text="Desligado" Style="{StaticResource MetaText}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="TrayBox" Style="{StaticResource ToggleSwitch}" Click="TrayClicked"
                                          AutomationProperties.Name="Fechar para a bandeja" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" />
                        <Grid Margin="16,14">
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="Ativar o motor ao abrir" Style="{StaticResource CardTitleText}" />
                                <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0"
                                           Text="Aplica os bindings do perfil ativo assim que o app abre." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="EngineStateText" Text="Desligado" Style="{StaticResource MetaText}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="EngineBox" Style="{StaticResource ToggleSwitch}" Click="EngineClicked"
                                          AutomationProperties.Name="Ativar o motor ao abrir" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ATALHOS" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Liga e desliga o motor" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource HelpButton}" Margin="6,0,0,0"
                                                ToolTip="O atalho e o botão ficam bloqueados por 2 segundos após cada troca."
                                                AutomationProperties.Name="Ajuda do atalho do motor" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Kbd}" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource KbdText}" Text="Scroll Lock" />
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />
                                <Grid>
                                    <TextBlock Text="Parada de emergência" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl" /></Border>
                                        <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Alt" /></Border>
                                        <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Pause" /></Border>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />
                                <Grid>
                                    <TextBlock Text="Trocar de seção" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl" /></Border>
                                        <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="1" /></Border>
                                        <TextBlock Text="até" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="6" /></Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="IDIOMA" Style="{StaticResource SectionText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <Grid>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Idioma do app" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0"
                                               Text="Requer reabrir o NinoBind." />
                                </StackPanel>
                                <ComboBox x:Name="LanguageBox" Width="168" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" AutomationProperties.Name="Idioma" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="ARQUIVOS" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Configuração" Style="{StaticResource LabelText}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathText" Style="{StaticResource MonoField}" AutomationProperties.Name="Caminho da configuração" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="OpenConfigClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Abrir pasta" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Click="CopyConfigClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Copiar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="Log" Style="{StaticResource LabelText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LogText" Style="{StaticResource MonoField}" AutomationProperties.Name="Caminho do log" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="OpenLogClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Abrir pasta" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Click="CopyLogClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Copiar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource MetaText}"
                                       Text="O log registra apenas estados e contagens. Nunca grava teclas ou textos digitados." />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
