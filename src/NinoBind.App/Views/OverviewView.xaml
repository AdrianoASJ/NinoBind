<UserControl x:Class="NinoBind.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource PageShell}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}">
                    <Run Text="Visão " />
                    <Run Text="geral" Foreground="{StaticResource GoldBrush}" />
                </TextBlock>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,20"
                           Text="O que está configurado e o estado do motor." />

                <Border x:Name="WarningBanner"
                        Background="{StaticResource SelectionBrush}"
                        BorderBrush="{StaticResource DangerLineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" Style="{StaticResource BodyText}" />
                </Border>

                <Border x:Name="EngineCard" Background="{StaticResource EngineDangerFill}"
                        BorderBrush="{StaticResource DangerLineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconWell}" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="EngineTitle" Text="Motor parado" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource MetaText}" VerticalAlignment="Center"
                                           Text="Os bindings e macros só funcionam com o motor ativo. Atalho:" />
                                <Border Style="{StaticResource Kbd}" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource KbdText}" Text="Scroll Lock" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="EngineAction" Grid.Column="2"
                                Style="{StaticResource PriButton}" VerticalAlignment="Center"
                                Click="EngineClicked" AutomationProperties.Name="Ativar ou desativar o motor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="EngineActionLabel" Text="Ativar motor" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ClickableCard}" Click="GoDevices" AutomationProperties.Name="Ir para dispositivos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconWell}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE962;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DevicesValue" Style="{StaticResource StatText}" />
                                <TextBlock Text="Dispositivos" Style="{StaticResource CardTitleText}" />
                                <TextBlock x:Name="DevicesMeta" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ClickableCard}" Click="GoProfiles" AutomationProperties.Name="Ir para perfis">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconWell}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ProfileValue" Style="{StaticResource StatText}" />
                                <TextBlock Text="Perfil ativo" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="Trocar perfil" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource ClickableCard}" Click="GoBindings" AutomationProperties.Name="Ir para bindings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconWell}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="BindingsValue" Style="{StaticResource StatText}" />
                                <TextBlock Text="Bindings ativos" Style="{StaticResource CardTitleText}" />
                                <TextBlock x:Name="BindingsMeta" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource ClickableCard}" Click="GoMacros" AutomationProperties.Name="Ir para macros">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconWell}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="MacrosValue" Style="{StaticResource StatText}" />
                                <TextBlock Text="Macros" Style="{StaticResource CardTitleText}" />
                                <TextBlock x:Name="MacrosMeta" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ATALHOS" Style="{StaticResource SectionText}" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="Liga e desliga o motor" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Kbd}" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource KbdText}" Text="Scroll Lock" />
                                </Border>
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />
                            <Grid>
                                <TextBlock Text="Parada de emergência" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl" /></Border>
                                    <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Alt" /></Border>
                                    <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Pause" /></Border>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />
                            <Grid>
                                <TextBlock Text="Trocar de seção" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl" /></Border>
                                    <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="1" /></Border>
                                    <TextBlock Text="até" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="6" /></Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ATIVIDADE RECENTE" Style="{StaticResource SectionText}" />
                            <ItemsControl x:Name="ActivityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource IconBlueBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding At, StringFormat=HH:mm}" Style="{StaticResource MetaText}"
                                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
