<UserControl x:Class="NinoBind.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="Visão geral" Style="{StaticResource TitleText}" />
            <TextBlock x:Name="EngineText" Style="{StaticResource BodyText}" Margin="0,8,0,20" />
            <Border x:Name="WarningBanner"
                    Background="#3A2E22"
                    BorderBrush="{StaticResource WarnBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
            </Border>
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Dispositivos" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="DevicesValue" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Perfil ativo" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ProfileValue" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,8,8,0">
                    <StackPanel>
                        <TextBlock Text="Bindings ativos" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="BindingsValue" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Macros" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="MacrosValue" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,20,0,0"
                       Text="Crie bindings em Bindings (Ctrl + 3) e macros em Macros (Ctrl + 4). Scroll Lock liga e desliga o motor. Ctrl + Alt + Pause interrompe todas as macros e pausa o motor." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
