<UserControl x:Class="NinoBind.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="CONJUNTOS DE BINDINGS" Style="{StaticResource EyebrowText}" />
            <TextBlock Style="{StaticResource TitleText}">
                <Run Text="Os seus " />
                <Run Text="perfis" Foreground="{StaticResource AccentBrush}" />
            </TextBlock>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,16"
                       Text="O motor usa só os bindings do perfil ativo. Ao trocar de perfil, as macros param e as teclas sintetizadas que estavam pressionadas são soltas." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Nome" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="NameBox" Width="240" Tag="Nome do perfil" MaxLength="60" AutomationProperties.Name="Nome do perfil" />
            </StackPanel>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Novo" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="AddClicked" AutomationProperties.Name="Novo perfil com o nome digitado" />
                <Button Content="Renomear" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="RenameClicked" AutomationProperties.Name="Renomear perfil selecionado" />
                <Button Content="Duplicar" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="DuplicateClicked" AutomationProperties.Name="Duplicar perfil selecionado com os bindings" />
                <Button Content="Excluir" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="DeleteClicked" AutomationProperties.Name="Excluir perfil selecionado" />
                <Button Content="Ativar" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ActivateClicked" AutomationProperties.Name="Ativar perfil selecionado" />
                <Button Content="Exportar" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ExportClicked" AutomationProperties.Name="Exportar perfil selecionado" />
                <Button Content="Importar" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="ImportClicked" AutomationProperties.Name="Importar perfil de arquivo" />
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        <ListView x:Name="ProfileList" AutomationProperties.Name="Lista de perfis" SelectionChanged="ProfileSelected">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="260" />
                    <GridViewColumn Header="Bindings" DisplayMemberBinding="{Binding Bindings}" Width="90" />
                    <GridViewColumn Header="Macros usadas" DisplayMemberBinding="{Binding Macros}" Width="120" />
                    <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding State}" Width="100" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
