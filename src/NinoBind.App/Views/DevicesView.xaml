<UserControl x:Class="NinoBind.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Style="{StaticResource TitleText}">
                    <Run Text="Os " />
                    <Run Text="dispositivos" Foreground="{StaticResource GoldBrush}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="CountText" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource HelpButton}" Margin="8,0,0,0"
                            ToolTip="O Raw Input associa o evento ao aparelho. Um hook global, sozinho, não faz essa separação."
                            AutomationProperties.Name="Ajuda sobre dispositivos" />
                </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MetaText}" Margin="0,16,0,0"
                       Text="Fabricante e nome aparecem quando o Windows os informa." />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="MOUSES" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource BadgeNeutral}" Margin="8,0,0,0">
                            <TextBlock x:Name="MouseCount" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralBrush}" />
                        </Border>
                    </StackPanel>
                    <Grid x:Name="MouseHost" Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="TECLADOS" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource BadgeNeutral}" Margin="8,0,0,0">
                            <TextBlock x:Name="KeyboardCount" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralBrush}" />
                        </Border>
                    </StackPanel>
                    <Grid x:Name="KeyboardHost" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Entradas ao vivo" Style="{StaticResource CardTitleText}" />
                    <TextBlock Style="{StaticResource MetaText}" Margin="0,6,0,14"
                               Text="Pressione uma tecla ou botão para ver qual aparelho enviou." />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ObserveButton" Content="Observar entradas" Style="{StaticResource OutButton}"
                                Click="ObserveClicked" AutomationProperties.Name="Observar entradas" />
                        <Button x:Name="RefreshButton" Grid.Column="2" Content="Atualizar" Style="{StaticResource GhostButton}"
                                Click="RefreshClicked" AutomationProperties.Name="Atualizar dispositivos" />
                    </Grid>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Enviar F13 de teste" Style="{StaticResource GhostButton}"
                        Margin="0,12,0,0" Click="TestClicked" x:Name="TestButton" Visibility="Collapsed"
                        HorizontalAlignment="Left" AutomationProperties.Name="Enviar tecla de teste F13" />
                <TextBlock x:Name="TestResult" DockPanel.Dock="Bottom" Style="{StaticResource MetaText}" Margin="0,8,0,0" />
                <StackPanel x:Name="WaitingRow" Orientation="Horizontal" Margin="0,4,0,8">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Aguardando entrada…" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="EventList" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         AutomationProperties.Name="Eventos observados">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Device}" Foreground="{StaticResource GoldBrush}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <TextBlock Text=" · " Foreground="{StaticResource TextDimBrush}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="{Binding Time}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
