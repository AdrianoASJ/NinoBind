<UserControl x:Class="NinoBind.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Dispositivos" Style="{StaticResource TitleText}" />
        <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" Margin="0,8,0,16" TextWrapping="Wrap"
                   Text="O Raw Input associa o evento ao aparelho. Um hook global, sozinho, não faz essa separação. Fabricante e nome só aparecem quando a API os entrega." />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TECLADOS E MOUSES" Style="{StaticResource SectionText}" />
                <TextBlock x:Name="EnumerationText" DockPanel.Dock="Bottom" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                <ListBox x:Name="DeviceList" AutomationProperties.Name="Lista de dispositivos">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" FontSize="12" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Path}" Style="{StaticResource BodyText}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="ENTRADAS" Style="{StaticResource SectionText}" />
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="ObserveButton" Content="Observar entradas" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="ObserveClicked" AutomationProperties.Name="Observar entradas" />
                    <Button x:Name="RefreshButton" Content="Atualizar" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="RefreshClicked" AutomationProperties.Name="Atualizar dispositivos" />
                    <Button x:Name="TestButton" Content="Enviar F13 de teste" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="TestClicked" IsEnabled="False" AutomationProperties.Name="Enviar tecla de teste F13" />
                </WrapPanel>
                <TextBlock x:Name="ObserveState" DockPanel.Dock="Top" Style="{StaticResource BodyText}" Margin="0,0,0,8" Text="Observação desligada. Nenhuma tecla está sendo lida." />
                <ListBox x:Name="EventList" AutomationProperties.Name="Eventos observados" />
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="TestResult" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
