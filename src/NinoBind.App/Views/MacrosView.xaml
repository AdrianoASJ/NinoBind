<UserControl x:Class="NinoBind.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PageShell}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}">
                        <Run Text="As suas " />
                        <Run Text="macros" Foreground="{StaticResource GoldBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Text="Sequências de teclas, cliques e esperas disparadas por binding." />
                        <Button x:Name="HelpButton" Style="{StaticResource HelpButton}" Margin="8,0,0,0"
                                AutomationProperties.Name="Ajuda sobre macros" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="StopButton" Content="Parar todas" Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0" Click="StopClicked" AutomationProperties.Name="Parar todas as macros" />
                    <Button x:Name="AddButton" Content="+  Nova macro" Style="{StaticResource PriButton}"
                            Click="AddClicked" AutomationProperties.Name="Nova macro" />
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Padding="32,0,10,0" Tag="Pesquisar macros"
                         TextChanged="FilterChanged" AutomationProperties.Name="Pesquisar macros" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <StackPanel>
            <Border x:Name="EmptyPanel" Style="{StaticResource EmptyState}" Visibility="Collapsed" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconWell}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                    </Border>
                    <TextBlock Text="Nenhuma macro ainda" Style="{StaticResource CardTitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Grave uma sequência para disparar por um binding."
                               Style="{StaticResource MetaText}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                    <Button Content="Nova macro" Style="{StaticResource PriButton}" HorizontalAlignment="Center"
                            Click="AddClicked" AutomationProperties.Name="Criar a primeira macro" />
                </StackPanel>
            </Border>

            <ListView x:Name="MacroList" AutomationProperties.Name="Lista de macros" MouseDoubleClick="EditClicked">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="240">
                            <GridViewColumn.Header>
                                <TextBlock Text="NOME" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource IconBlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90">
                            <GridViewColumn.Header>
                                <TextBlock Text="PASSOS" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Steps}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="160">
                            <GridViewColumn.Header>
                                <TextBlock Text="REPETIÇÃO" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NeutralChip}">
                                        <TextBlock Text="{Binding Repeat}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NeutralBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="120">
                            <GridViewColumn.Header>
                                <TextBlock Text="ATRASO TOTAL" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Delay}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90">
                            <GridViewColumn.Header>
                                <TextBlock Text="BINDINGS" FontSize="11" FontWeight="SemiBold" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Uses}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="148">
                            <GridViewColumn.Header>
                                <TextBlock Text="AÇÕES" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Testar"
                                                Tag="{Binding Id}" Click="TestRowClicked" AutomationProperties.Name="Testar macro" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Editar"
                                                Tag="{Binding Id}" Click="EditRowClicked" AutomationProperties.Name="Editar macro" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicar"
                                                Tag="{Binding Id}" Click="DuplicateRowClicked" AutomationProperties.Name="Duplicar macro" />
                                        <Button Style="{StaticResource IconButton}" ToolTip="Excluir"
                                                Tag="{Binding Id}" Click="DeleteRowClicked" AutomationProperties.Name="Excluir macro">
                                            <TextBlock Text="&#xE74D;" Foreground="{StaticResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border x:Name="RunBadge" Style="{StaticResource BadgeNeutral}">
                    <TextBlock x:Name="RunBadgeText" Text="Ocioso" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource NeutralBrush}" />
                </Border>
                <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" Margin="10,0,16,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Ctrl" /></Border>
                <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Alt" /></Border>
                <TextBlock Text="+" Margin="6,0" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Kbd}"><TextBlock Style="{StaticResource KbdText}" Text="Pause" /></Border>
                <TextBlock Text="para todas" Style="{StaticResource MetaText}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
